# Supabase (production seulement — ne jamais committer ces valeurs !)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret URL admin (optionnel)
# Permet d'accéder à /admin?secret=<valeur> sans saisir le PIN
# Utilisez une chaîne aléatoire longue (ex: openssl rand -base64 32)
VITE_ADMIN_SECRET=changez-moi-par-une-valeur-aleatoire-longue
